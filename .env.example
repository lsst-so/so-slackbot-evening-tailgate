# Slack app credentials (see README.md for how to get these)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Channel where the reminder / confirmation / cancellation messages are posted
TAILGATE_CHANNEL_ID=C0123456789

# Slack User Group whose members are allowed to click "Confirm Meeting".
# Also @-mentioned in the reminder.
DAY_OBS_USERGROUP_ID=S0123456789

# Optional. Additional Slack User Group @-mentioned in the reminder for
# awareness. Its members are NOT allowed to confirm the meeting. Leave
# unset to mention only DAY_OBS_USERGROUP_ID.
SCI_SUP_SHIFT_USERGROUP_ID=

# Fixed meeting link posted once confirmed
TAILGATE_MEETING_LINK=https://your-meet-link.example.com/tailgate

# Optional overrides (defaults shown)
TAILGATE_TIMEZONE=America/Santiago
TAILGATE_REMINDER_TIME=16:15
TAILGATE_CUTOFF_TIME=16:25
TAILGATE_MEETING_TIME_LABEL=16:30

# Whether the reminder @-mentions the user group(s) above so their members
# are notified. Accepts 1/true/yes/on (default) or 0/false/no/off.
TAILGATE_MENTION_USERGROUP=true

# Leave TAILGATE_DB_PATH unset. Each deployment picks its own safe default:
# running the app directly / via systemd uses "tailgate_state.db" next to app.py;
# the Docker image defaults to /data/tailgate_state.db, which is the mounted
# volume. Setting it here would override that Docker default with a path
# *inside* the container that isn't on the volume, and the state would be
# silently lost on every container recreate.
# TAILGATE_DB_PATH=tailgate_state.db
