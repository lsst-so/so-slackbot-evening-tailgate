[Unit]
Description=Evening Tailgate Meeting Slack bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust these two paths for wherever you deploy the bot:
WorkingDirectory=/opt/tailgate-bot
ExecStart=/opt/tailgate-bot/.venv/bin/tailgate-bot
EnvironmentFile=/opt/tailgate-bot/.env
Restart=on-failure
RestartSec=10
User=tailgate-bot

[Install]
WantedBy=multi-user.target
